<?xml version="1.0" encoding="utf-8"?>

<!-- Identity package with an external location: background lighting needs identity,
     the files come from %LOCALAPPDATA%\Sunlight-Flow. Version is filled in by build.ps1. -->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 uap10 rescap">

  <Identity
    Name="SunlightFlow"
    Publisher="CN=lysnet.ru"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Sunlight-Flow</DisplayName>
    <PublisherDisplayName>lysnet.ru</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Sunlight-Flow.exe"
                 uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">

      <!-- Start gets its shortcut from the MSI. -->
      <uap:VisualElements
        DisplayName="Sunlight-Flow"
        Description="Motherboard lighting driven by sun elevation"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>

        <!-- The whole reason for the package: this extension puts the app into
             the background lighting control list in Settings. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.windows.lighting"
            Id="SunlightFlow"
            PublicFolder="Public"
            DisplayName="Sunlight-Flow" />
        </uap3:Extension>

        <!-- Autostart through the package, so it survives updates and can be
             switched off in Task Manager like any other startup app. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Sunlight-Flow.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="SunlightFlowAutoStart"
            Enabled="false"
            DisplayName="Sunlight-Flow" />
        </uap5:Extension>

      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

</Package>
