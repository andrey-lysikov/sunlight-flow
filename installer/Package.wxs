<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Sunlight-Flow"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="3F6AA386-2CA7-4C67-B46F-9F769BD8E510"
           Scope="perMachine"
           Compressed="yes"
           Language="1033"
           Codepage="1252">

    <!-- Same version too, so a rebuilt installer replaces the previous one
         instead of registering a second product next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Sunlight-Flow is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="WindowsBuildNumber"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000)"
            Message="Requires 64-bit Windows 11 build 22000 or newer." />

    <Icon Id="AppIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrey-lysikov/sunlight-flow" />

    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

    <!-- The app, the package, the config and the log all live here; the identity
         package takes this folder as its external location. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Sunlight-Flow" />
    </StandardDirectory>

    <ComponentGroup Id="PackagePayload" Directory="INSTALLFOLDER">
      <Files Include="$(Payload)\**" />
      <Component Id="MsixPackage">
        <File Id="MsixFile" Source="$(Msix)" Name="Sunlight-Flow.msix" KeyPath="yes" />
      </Component>
      <Component Id="SigningCertificate">
        <File Id="CerFile" Source="$(Certificate)" Name="Sunlight-Flow.cer" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The package has no app list entry of its own, so Start gets its shortcut
         from here. The exe picks up the package identity by itself. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut"
                  Name="Sunlight-Flow"
                  Description="Motherboard lighting driven by sun elevation"
                  Target="[INSTALLFOLDER]Sunlight-Flow.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\Sunlight-Flow" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Sunlight-Flow" Level="1">
      <ComponentGroupRef Id="PackagePayload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Update mode. Worked out before the first dialog and in both sequences,
         because the UI and the execution run in separate processes. -->
    <Property Id="PERUSERCOPY" Secure="yes">
      <DirectorySearch Id="PerUserFolderSearch" Path="[LocalAppDataFolder]Sunlight-Flow">
        <FileSearch Id="PerUserMsixSearch" Name="Sunlight-Flow.msix" />
      </DirectorySearch>
    </Property>

    <SetProperty Action="SetUpdateMode" Id="UPDATEMODE" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT Installed AND (WIX_UPGRADE_DETECTED OR PERUSERCOPY)" />

    <!-- The start dialogs are virtual in WiX 6, so update mode swaps them for UpdateDlg.
         No folder choice: the app always goes to %LOCALAPPDATA%. -->
    <InstallUISequence>
      <Show Dialog="override WelcomeEulaDlg" Before="ProgressDlg" Condition="0" />
      <Show Dialog="LicenseDlg" Before="ProgressDlg"
            Condition="(NOT Installed OR PATCH) AND NOT UPDATEMODE" />
      <Show Dialog="override MaintenanceWelcomeDlg" Before="ProgressDlg"
            Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH AND NOT UPDATEMODE" />
      <Show Dialog="UpdateDlg" Before="ProgressDlg" Condition="UPDATEMODE AND NOT Installed" />
    </InstallUISequence>

    <!-- Immediate: a deferred action before RemoveExistingProducts fails with 2613.
         Wait-Process gives the app time to release its files. -->
    <SetProperty Action="SetStopApp" Id="WixQuietExecCmdLine" Sequence="execute" Before="StopApp"
                 Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Stop-Process -Name Sunlight-Flow -Force -ErrorAction SilentlyContinue; Wait-Process -Name Sunlight-Flow -Timeout 15 -ErrorAction SilentlyContinue; exit 0&quot;" />

    <CustomAction Id="StopApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <SetProperty Id="TrustCertificate"
                 Value="&quot;[System64Folder]certutil.exe&quot; -f -addstore TrustedPeople &quot;[INSTALLFOLDER]Sunlight-Flow.cer&quot;"
                 Before="TrustCertificate"
                 Sequence="execute" />

    <SetProperty Id="ForgetCertificate"
                 Value="&quot;[System64Folder]certutil.exe&quot; -delstore TrustedPeople &quot;lysnet.ru&quot;"
                 Before="ForgetCertificate"
                 Sequence="execute" />

    <SetProperty Id="RegisterPackage"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$old = Get-AppxPackage -Name SunlightFlow; if ($old -and (Get-AppxPackageManifest $old).Package.Properties.AllowExternalContent -ne 'true') { Remove-AppxPackage $old }; Add-AppxPackage -Path '[INSTALLFOLDER]Sunlight-Flow.msix' -ExternalLocation '[INSTALLFOLDER]' -ForceUpdateFromAnyVersion -ForceApplicationShutdown; $pkg = Get-AppxPackage -Name SunlightFlow; Start-Process ('shell:AppsFolder\' + $pkg.PackageFamilyName + '!App')&quot;"
                 Before="RegisterPackage"
                 Sequence="execute" />

    <SetProperty Id="UnregisterPackage"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Stop-Process -Name Sunlight-Flow -Force -ErrorAction SilentlyContinue; Wait-Process -Name Sunlight-Flow -Timeout 15 -ErrorAction SilentlyContinue; Get-AppxPackage -Name SunlightFlow | Remove-AppxPackage; Remove-Item -LiteralPath '[LocalAppDataFolder]Sunlight-Flow' -Recurse -Force -ErrorAction SilentlyContinue; exit 0&quot;"
                 Before="UnregisterPackage"
                 Sequence="execute" />

    <CustomAction Id="TrustCertificate" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <CustomAction Id="RegisterPackage" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="yes" Return="check" />

    <CustomAction Id="UnregisterPackage" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <CustomAction Id="ForgetCertificate" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- An upgrade keeps the package and the certificate, so autostart and the
         lighting permission survive. Uninstall removes them with the settings. -->
    <InstallExecuteSequence>
      <Custom Action="StopApp" Before="RemoveExistingProducts" Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterPackage" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ForgetCertificate" After="UnregisterPackage" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- On repair too, so running the installer again restores a missing package. -->
      <Custom Action="TrustCertificate" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterPackage" After="TrustCertificate" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />

  </Package>
</Wix>
