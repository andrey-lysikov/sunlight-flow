<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- WelcomeEulaDlg with the checkbox moved off the bitmap: a checkbox cannot be
       transparent, so on the bitmap it showed a grey patch. -->
  <Fragment>
    <UI>
      <Dialog Id="LicenseDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234"
                 TabSkip="no" Text="!(loc.WelcomeEulaDlgBitmap)" />
        <Control Id="Title" Type="Text" X="130" Y="6" Width="225" Height="30"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.WelcomeEulaDlgTitle)" />
        <Control Id="LicenseText" Type="ScrollableText" X="130" Y="36" Width="226" Height="188"
                 Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.WixUILicenseRtf)" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="10" Y="243" Width="206" Height="17"
                 CheckBoxValue="1" Property="LicenseAgreed"
                 Text="!(loc.WelcomeEulaDlgLicenseAcceptedCheckBox)" />
        <Control Id="Install" Type="PushButton" X="224" Y="243" Width="72" Height="17"
                 Default="yes" ElevationShield="yes" Text="!(loc.WelcomeEulaDlgInstall)"
                 DisableCondition="LicenseAgreed &lt;&gt; &quot;1&quot;"
                 EnableCondition="LicenseAgreed = &quot;1&quot;">
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="CostingComplete = 1" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="OutOfDiskSpace = 1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
